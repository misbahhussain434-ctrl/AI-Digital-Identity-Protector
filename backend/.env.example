# Server
PORT=5000
NODE_ENV=development

# MongoDB (leave empty to use in-memory database for development)
MONGODB_URI=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Admin seed account
ADMIN_EMAIL=admin@identityprotector.com
ADMIN_PASSWORD=Admin@123456

# Rate limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Alert thresholds
UNAUTHORIZED_ALERT_THRESHOLD=3
FAILED_LOGIN_ALERT_THRESHOLD=5
